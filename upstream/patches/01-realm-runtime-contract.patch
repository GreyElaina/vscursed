+
+import type { IInstantiationService } from '../../platform/instantiation/common/instantiation.js';
+
+/**
+ * Starts the realm of a local extension host: it loads the extension-host modules of the plugins that
+ * this host runs, and joins the host's termination to unload them.
+ */
+export declare function start(instantiationService: IInstantiationService): void;
